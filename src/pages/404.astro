---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found — clean4park"
  description="This page does not exist. Head back to clean4park.com."
>
  <section class="mx-auto max-w-3xl px-4 py-28 text-center sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue">404</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-navy">This pitch is empty.</h1>
    <p class="mt-4 text-navy/70">The page you are looking for is not here. Try the homepage instead.</p>
    <a
      href="/"
      class="mt-8 inline-flex items-center rounded-full bg-mint px-6 py-3 text-sm font-semibold text-navy hover:bg-mint-dark"
    >
      Back to clean4park
    </a>
  </section>
</BaseLayout>
